# =============================================================================
# ZenSpace — variáveis de ambiente
# Copie para .env (local) ou cadastre em Vercel → Settings → Environment Variables
# =============================================================================

# --- Login com Google (obrigatório para aparecer o botão "Fazer login com o Google") ---
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (Aplicativo da Web)
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Sessão (obrigatório em produção) ---
# Texto aleatório com 32+ caracteres. Gere com:  openssl rand -hex 32
# Sem ele, o login funciona mas os usuários são deslogados a cada reinício do servidor.
SESSION_SECRET=troque-por-um-valor-aleatorio-de-64-caracteres-hexadecimais-xxxx

# --- Banco SQLite persistente na Vercel (recomendado) ---
# Turso (https://turso.tech): turso db create zenspace
#   URL:   turso db show zenspace --url
#   Token: turso db tokens create zenspace
# Sem estas variáveis a Vercel usa /tmp/zenspace.db (funciona, mas é temporário).
TURSO_DATABASE_URL=libsql://zenspace-seu-usuario.turso.io
TURSO_AUTH_TOKEN=

# --- Somente local / Docker (opcional) ---
# Caminho do arquivo SQLite. Padrão: ./data/zenspace.db
# SQLITE_PATH=./data/zenspace.db
# PORT=8080
