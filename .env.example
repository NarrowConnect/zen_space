# Opcional: SQLite persistente na Vercel via Turso (https://turso.tech)
# Sem estas variáveis a Vercel usa /tmp/zenspace.db (funciona, mas é temporário).
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# Opcional (local/Docker): caminho do arquivo SQLite. Padrão: ./data/zenspace.db
# SQLITE_PATH=./data/zenspace.db
